    {
      "parameters": {
        "jsCode": "const FALLBACK = \"I'm not sure about that. Let me connect you with our team.\";\nconst tg = $('Telegram Trigger').item.json.message;\nconst out = ($json.output || '').toString().trim();\nconst failed = !out || !!$json.error;\nlet handoff = failed || out.includes('[HANDOFF]');\nlet reply = out.replace(/\\[HANDOFF\\]/g, '').trim();\nlet enroll = false, course = '', student = '', phone = '';\nconst m = reply.match(/\\[ENROLL\\]([\\s\\S]*?)\\[\\/ENROLL\\]/);\nif (m) {\n  reply = reply.replace(m[0], '').trim();\n  const p = m[1].split('|').map(x => x.trim());\n  const digits = (p[2] || '').replace(/\\D/g, '');\n  const safe = x => { x = (x || '').slice(0, 80); return /^[=+\\-@]/.test(x) ? \"'\" + x : x; };\n  if (p[0] && p[1] && digits.length >= 10 && digits.length <= 13) {\n    enroll = true; handoff = false;\n    course = safe(p[0]); student = safe(p[1]); phone = digits;\n  } else {\n    reply = 'Sorry, the details look incomplete. Please send your full name and 10-digit mobile number again.';\n  }\n}\nif (failed || !reply) reply = FALLBACK;\nif (reply.length > 3500) reply = reply.slice(0, 3500) + '...';\nconst esc = x => x.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst html = esc(reply).replace(/\\*\\*(.+?)\\*\\*/g, '<b>$1</b>');\nreturn [{ json: { html, handoff, enroll, course, student, phone,\n  question: tg.text || '', chat_id: String(tg.chat.id),\n  name: (tg.from && tg.from.first_name) || '' }}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        280
